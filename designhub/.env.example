# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=designhub
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT (JSON Web Token) Security Configuration
# Chuỗi bí mật ký HMAC-SHA256 (Base64 encoded, tối thiểu 256 bits / 32 bytes)
# Ví dụ sinh chuỗi mẫu: openssl rand -base64 32
JWT_SECRET=c2VjdXJlX2p3dF9zZWNyZXRfa2V5X2Zvcl9kZXNpZ25odWJfYXBwbGljYXRpb25fMjAyNA==

# Thời gian hết hạn của token (tính bằng milliseconds)
# 1800000 ms = 30 phút, 86400000 ms = 24 giờ
JWT_EXPIRATION=86400000
